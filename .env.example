# 이 파일을 복사해서 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.
# .env 는 GitHub에 올라가지 않습니다.
BASE_URL=http://QA서버주소:포트
QA_USER_ID=
QA_USER_PW=
QA_COMPANY=Dream4.1 (QA)
# 테스트가 만든 데이터 이름 앞에 붙는 표시. 사람마다 다르게 (예: [sychoi]). 비우면 [로그인ID]
QA_TAG=

# 사이트가 둘 이상이면 .env.mssql 처럼 파일을 하나 더 만들고 다른 값만 적습니다.
# 실행 전에 $env:QA_SITE="mssql" 을 주면 그 파일을 씁니다. (안 주면 .env = oracle)
# 회사를 고르지 않는 사이트는 QA_COMPANY= 처럼 비워 둡니다.
